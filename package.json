{
  "name": "kubus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --config app/vite.config.ts",
    "build": "tauri build",
    "build:web": "tsc --noEmit && vite build --config app/vite.config.ts",
    "build:headless": "vite build --config app/vite.headless.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/main",
    "test:coverage": "vitest run --coverage",
    "coverage:report": "node --disable-warning=ExperimentalWarning tests/coverage.mjs",
    "test:gui": "node gui-tests/run.mjs",
    "test:gui:smoke": "node gui-tests/run.mjs --smoke",
    "suite": "node tests/run.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@carbon/charts-react": "^1.27.23",
    "@carbon/colors": "^11.61.0",
    "@carbon/icons-react": "^11.90.0",
    "@carbon/react": "^1.118.0",
    "@ibm/plex-mono": "^2.5.0",
    "@ibm/plex-sans": "^1.1.0",
    "@milkdown/kit": "^7.22.3",
    "@milkdown/plugin-prism": "^7.22.3",
    "@milkdown/react": "^7.22.3",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "d3-geo": "^3.1.1",
    "maplibre-gl": "^6.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "refractor": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "^1.0.2",
    "@tauri-apps/cli": "^2.12.3",
    "@types/d3-geo": "^3.1.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ast-v8-to-istanbul": "^1.0.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "sass": "^1.105.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
