{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  "include": ["app/src", "app/vite.config.ts", "app/vite.headless.config.ts", "shared"],
  // Tests of server code (vitest runs them): the server's packages and sources aren't there for every
  // typecheck of the app (CI installs the app's alone; the server image's web stage has no server/).
  "exclude": ["app/src/data/remote/postgres.test.ts", "app/src/data/remote/postgresSql.test.ts", "app/src/data/remote/settings.test.ts"]
}
