{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "*:*" }],
      "deny": [
        { "url": "javascript:*" },
        { "url": "vbscript:*" },
        { "url": "data:*" },
        { "url": "file:*" },
        { "url": "blob:*" },
        { "url": "about:*" },
        { "url": "filesystem:*" }
      ]
    }
  ]
}
